# NewsFlash environment variables
# Copy to .env.local for local development. Never commit real secrets.

# Required for Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional alias for the public key
# VAPID_PUBLIC_KEY=

# Required in production / Vercel for cron and ops endpoints
CRON_SECRET=

# Preferred push subscription storage
DATABASE_URL=
# POSTGRES_URL=

# Optional fallback storage if Postgres is unavailable
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
