# NewsFlash environment variables
# Copy to .env.local for local development. Never commit real secrets.

# Required for Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional alias for the public key
# VAPID_PUBLIC_KEY=

# Required in production / Vercel for cron and ops endpoints
CRON_SECRET=

# Preferred storage: Upstash Redis (Vercel Marketplace sets these automatically).
# Either pair works. When set, Redis is used instead of Postgres/Blob.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Set to "true" once old Neon data has been copied (or is no longer needed).
# DISABLE_LEGACY_MIGRATION=true

# Legacy storage (read once to migrate into Redis, or used when Redis is absent)
DATABASE_URL=
# POSTGRES_URL=

# Optional fallback storage if Postgres is unavailable
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
